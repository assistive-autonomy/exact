// ExAct motion program grammar
// Programs describe temporal motion segments with joint sensor observations

start: motion (";" motion)*

motion: "[" INT "," INT "]" sensor ("*" sensor)*

sensor: JOINT "." AXIS "(" VALUE ")"

// Body joints (24 total)
JOINT: "pelvis" | "torso" | "spine" | "chest" | "neck" | "head"
    | "lhip" | "lknee" | "lankle" | "ltoe"
    | "rhip" | "rknee" | "rankle" | "rtoe"
    | "lthorax" | "lshoulder" | "lelbow" | "lwrist" | "lhand"
    | "rthorax" | "rshoulder" | "relbow" | "rwrist" | "rhand"

// Spatial axes
AXIS: "x" | "y" | "z"

// Integer for time indices (higher priority than VALUE using .1 suffix)
INT.1: /[0-9]+/

// Floating point value for sensor readings (can be negative)
VALUE: /-?[0-9]+\.[0-9]+/ | /-?[0-9]+/ | /-?\.[0-9]+/

// Ignore whitespace between tokens
%ignore /\s+/


